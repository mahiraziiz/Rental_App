generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Highlight {
  HighSpeedInternetAccess
  WasherDryer
  AirConditioning
  Heating
  SmokeFree
  CableReady
  SatelliteTV
  DoubleVanities
  TubShower
  Intercom
  SprinklerSystem
  RecentlyRenovated
  CloseToTransit
  GreatView
  QuietNeighborhood
}

enum Amenity {
  WasherDryer
  AirConditioning
  Dishwasher
  HighSpeedInternet
  HardwoodFloors
  WalkInClosets
  Microwave
  Refrigerator
  Pool
  Gym
  Parking
  PetsAllowed
  WiFi
}

enum PropertyType {
  Rooms
  Tinyhouse
  Apartment
  Villa
  Townhouse
  Cottage
}

enum ApplicationStatus {
  Pending
  Denied
  Approved
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
  Overdue
  Refunded
}

// User model - Main auth table
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("tenant") // "tenant", "manager", "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant  Tenant?
  manager Manager?

  @@map("users")
}

// Tenant profile - linked to User by userId
model Tenant {
  id          Int      @id @default(autoincrement())
  userId      String   @unique // References User.id (JWT ID)
  name        String
  email       String   @unique
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties   Property[]    @relation("TenantProperties")
  favorites    Property[]    @relation("TenantFavorites")
  applications Application[]
  leases       Lease[]
}

// Manager profile - linked to User by userId
model Manager {
  id          Int      @id @default(autoincrement())
  userId      String   @unique // References User.id (JWT ID)
  name        String
  email       String   @unique
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedProperties Property[] @relation("ManagerProperties")
}

model Property {
  id                Int          @id @default(autoincrement())
  name              String
  description       String
  pricePerMonth     Float
  securityDeposit   Float
  applicationFee    Float
  photoUrls         String[]
  amenities         Amenity[]
  highlights        Highlight[]
  isPetsAllowed     Boolean      @default(false)
  isParkingIncluded Boolean      @default(false)
  beds              Int
  baths             Float
  squareFeet        Int
  propertyType      PropertyType
  isActive          Boolean      @default(true)
  averageRating     Float?       @default(0)
  numberOfReviews   Int?         @default(0)
  locationId        Int
  managerUserId     String // References User.id (JWT ID)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  location     Location      @relation(fields: [locationId], references: [id])
  manager      Manager       @relation("ManagerProperties", fields: [managerUserId], references: [userId])
  leases       Lease[]
  applications Application[]
  favoritedBy  Tenant[]      @relation("TenantFavorites")
  tenants      Tenant[]      @relation("TenantProperties")
}

model Location {
  id          Int                                   @id @default(autoincrement())
  address     String
  city        String
  state       String
  country     String
  postalCode  String
  coordinates Unsupported("geography(Point, 4326)")
  createdAt   DateTime                              @default(now())

  // Relations
  properties Property[]
}

model Application {
  id              Int               @id @default(autoincrement())
  applicationDate DateTime          @default(now())
  status          ApplicationStatus @default(Pending)
  propertyId      Int
  tenantUserId    String // References User.id (JWT ID)
  message         String?
  leaseId         Int?              @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantUserId], references: [userId], onDelete: Cascade)
  lease    Lease?   @relation(fields: [leaseId], references: [id])
}

model Lease {
  id           Int      @id @default(autoincrement())
  startDate    DateTime
  endDate      DateTime
  rent         Float
  deposit      Float
  propertyId   Int
  tenantUserId String // References User.id (JWT ID)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantUserId], references: [userId], onDelete: Cascade)
  application Application?
  payments    Payment[]
}

model Payment {
  id            Int           @id @default(autoincrement())
  amountDue     Float
  amountPaid    Float         @default(0)
  dueDate       DateTime
  paymentDate   DateTime?
  paymentStatus PaymentStatus @default(Pending)
  leaseId       Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([leaseId, dueDate])
  @@index([paymentStatus])
}
